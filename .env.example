# Development branch ARM64 build for Apple Silicon and Raspberry Pi.
# Override this with an immutable sha-*-arm64 tag for reproducible releases.
ORCA_RUNTIME_IMAGE=ghcr.io/itymarcel/custom-orca:dev-arm64

SLICER_CONCURRENCY=1
SLICER_TIMEOUT_SECONDS=700
SLICER_MAX_FILE_BYTES=209715200

# Server-only. Copy this file to .env and put the real key there.
# Never use a VITE_ or REACT_APP_ prefix for the key.
OPENAI_API_KEY=
OPENAI_SLICER_MODEL=gpt-5.4
OPENAI_PREFILL_RATE_LIMIT=10
OPENAI_PREFILL_RATE_WINDOW_SECONDS=600
